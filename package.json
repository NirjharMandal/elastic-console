{
  "name": "elastic-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elastic Console — a native macOS Elasticsearch management console (Tauri v2 + React 19).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
